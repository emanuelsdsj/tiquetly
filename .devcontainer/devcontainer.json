{
  "name": "eventos-ingressos",
  "build": {
    "dockerfile": "Dockerfile"
  },
  "features": {
    "ghcr.io/devcontainers/features/node:1": {
      "version": "20"
    },
    "ghcr.io/devcontainers/features/docker-in-docker:2": {}
  },
  "forwardPorts": [8000, 5173],
  "portsAttributes": {
    "8000": {
      "label": "backend (FastAPI)"
    },
    "5173": {
      "label": "frontend (Vite)"
    }
  },
  "postCreateCommand": "bash -c 'sudo apt-get update && sudo apt-get install -y sqlite3; if [ -f backend/requirements-dev.txt ]; then python3 -m venv backend/.venv && backend/.venv/bin/pip install -r backend/requirements-dev.txt; fi; if [ -f frontend/package.json ]; then npm install --prefix frontend; fi'",
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "charliermarsh.ruff",
        "dbaeumer.vscode-eslint",
        "esbenp.prettier-vscode"
      ],
      "settings": {
        "editor.formatOnSave": true,
        "python.testing.pytestEnabled": true,
        "python.defaultInterpreterPath": "${workspaceFolder}/backend/.venv/bin/python"
      }
    }
  },
  "remoteUser": "vscode"
}
