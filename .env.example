# Variaveis para o docker-compose.yml (backend + frontend + Postgres).
# Copiar para .env antes de rodar `docker compose up`. Nao commitar o .env
# real. Os defaults abaixo sobem a stack sem nenhum ajuste, mas os
# segredos e chaves de API devem ser trocados por valores proprios antes
# de usar isso como demo real (ver backend/.env.example para o mesmo
# detalhe no fluxo sem Docker).

POSTGRES_USER=tiquetly
POSTGRES_PASSWORD=tiquetly
POSTGRES_DB=tiquetly

FRONTEND_ORIGIN=http://localhost:5173
VITE_API_URL=http://localhost:8000

JWT_SECRET_KEY=change-me
QR_HMAC_SECRET=change-me

# Chaves das APIs externas do catalogo. Gerar em:
# https://developer.ticketmaster.com
# https://developer.themoviedb.org
TICKETMASTER_API_KEY=
TMDB_API_KEY=
