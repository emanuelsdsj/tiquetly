# SQLite em dev (arquivo local, zero setup). Em producao, apontar para um
# Postgres, ex.: postgresql://user:password@host:5432/eventos
DATABASE_URL=sqlite:///./eventos.db

# Origem permitida no CORS, deve bater com onde o frontend roda.
FRONTEND_ORIGIN=http://localhost:5173

# Segredos: gerar valores proprios, nunca usar os defaults abaixo fora de
# desenvolvimento local.
JWT_SECRET_KEY=change-me
QR_HMAC_SECRET=change-me

# Chaves das APIs externas do catalogo. Gerar em:
# https://developer.ticketmaster.com
# https://developer.themoviedb.org
TICKETMASTER_API_KEY=
TMDB_API_KEY=
